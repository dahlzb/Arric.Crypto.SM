<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net4.0;net6.0;net7.0;net8.0;net9.0;</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Authors>DahlZb</Authors>
        <LangVersion>10.0</LangVersion>
        <Title>Arric.Crypto.SM</Title>
        <PackageTags>国密;SM;SM2;SM3;SM4;SM2加签</PackageTags>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/dahlzb/Arric.Crypto.SM</RepositoryUrl>
        <Description>国密 SM2加签验签，SM2、SM3、SM4加解密，可指定编码格式</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/dahlzb/Arric.Crypto.SM</PackageProjectUrl>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<Version>1.1.2</Version>
    </PropertyGroup>

    <ItemGroup>
      <None Include="..\LICENSE.txt">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
      <None Include="..\README.md">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    </ItemGroup>

</Project>
